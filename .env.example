# Salin menjadi .env lalu sesuaikan.
# Port di komputer host (akses lokal: http://localhost:3000)
OKIYA_PORT=3000

# Profil yang dijalankan otomatis oleh "docker compose up -d":
#   quick = quick tunnel trycloudflare (gratis, link berubah tiap restart)
#   named = named tunnel (butuh TUNNEL_TOKEN)
# Kosongkan bila tidak ingin tunnel.
COMPOSE_PROFILES=quick

# Untuk named tunnel: Cloudflare Zero Trust > Networks > Tunnels > Create tunnel (Cloudflared)
# Salin token-nya ke sini, lalu atur Public Hostname -> Service: http://okiya:3000
TUNNEL_TOKEN=
